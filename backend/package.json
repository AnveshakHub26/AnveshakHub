{
  "name": "anveshakhub-backend",
  "version": "1.0.0",
  "description": "AnveshakHub Enterprise NestJS Microservice Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
